# 复制为 apps/api/.env 并填入真实 Key（不要提交进 git）

# 供应商二选一：显式 BASE_URL，或用 OPENAI_PROVIDER 映射内置表
OPENAI_PROVIDER=deepseek          # deepseek | kimi | glm | openai | 留空配 OPENAI_BASE_URL
# OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=deepseek-chat        # kimi: moonshot-v1-8k / glm: glm-4-flash / openai: gpt-4o-mini

# 不配置 OPENAI_API_KEY 时，智能体自动回退为确定性剧本模式（离线可跑）
